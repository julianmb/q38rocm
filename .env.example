# ==============================================================================
# q38rocm Environment Configuration Template (.env)
# Copy this file to '.env' in the repo root to persist settings.
# ==============================================================================

# Required AMD Strix Halo APU Architecture Overrides
HSA_OVERRIDE_GFX_VERSION=11.5.1
GGML_HIP_ENABLE_UNIFIED_MEMORY=1

# Backend Device Selection (Vulkan0 = max decode speed on gfx1151; ROCm0 = fallback)
DEVICE=Vulkan0

# Default Context Window & KV Cache Settings
CTX_SIZE=131072
KV_K=q8_0
KV_V=turbo4

# MTP Speculative Decoding (Needs model with MTP/NextN head, e.g., Qwen3.6/3.8)
MTP=1
MTP_PROFILE=n4/p0.55
TEMP=0

# Sampling penalties (high presence penalties can corrupt long agent output)
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.05

# Quantization Defaults
PRIMARY_PRESET=Q4_0_ROCMFP4_STRIX_LEAN
QUALITY_PRESET=Q6_0_ROCMFPX_AGENT
